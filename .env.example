# pay-7331 settings. Copy to .env (mode 600, gitignored) and fill in. docker-compose.yml reads it for every service.

# --- Stores ---------------------------------------------------------------------------------------------------------
# Postgres password for the compose `postgres` service; compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=
# Only for running the backend outside compose (compose sets both to the stack's postgres and redis).
DATABASE_URL=postgresql+psycopg://pay:password@127.0.0.1:5432/pay
REDIS_URL=redis://127.0.0.1:6379/0

# --- Process --------------------------------------------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Origin of the public pages and API, as payers see it; invoice urls and the refund message carry it. Its host is the
# passkey RP id, which cannot be an IP address: use localhost locally, not 127.0.0.1.
PAY_PUBLIC_BASE_URL=http://localhost:18080
# Host port the API is published on (127.0.0.1 only).
PAY_API_PORT=18080
# API worker processes (uvicorn --workers).
PAY_API_WORKERS=2
# true only on the testnet sandbox (pay-sandbox.7331.org, PLAN.md section 16): every page shows "Sandbox — testnet
# money only".
PAY_SANDBOX=false

# --- Chains (backend/chains.toml) -----------------------------------------------------------------------------------
# Comma-separated chain keys: polygon, polygon_amoy, arbitrum, arbitrum_sepolia, local_fork, local_arbitrum_fork, monero, monero_stagenet.
PAY_ENABLED_CHAINS=polygon
# Per chain, upper-cased key: comma-separated RPC urls replacing chains.toml's list (first is primary).
PAY_RPC_URLS_POLYGON=
# Per chain: the deployed DepositForwarderFactory; without one the watcher skips the chain and invoices answer factory_not_deployed.
PAY_FACTORY_ADDRESS_POLYGON=
# Per chain: the refund key. It pays refunds from its float and their gas, creates the treasury Safe, and signs sweeps
# when no sweeper key is set. Secret.
PAY_OPERATOR_PRIVATE_KEY_POLYGON=
# Per chain: the sweeper pool, comma-separated private keys. Each new sweep goes to the active sweeper with the fewest
# active operations. Empty: the refund key sweeps. Each key holds gas only. Secret.
PAY_SWEEPER_PRIVATE_KEYS_POLYGON=
# Per chain: the treasury Safe that tops up the keys through the Allowance Module (`python -m app.cli treasury ...`).
# Overrides chains.toml's treasury_safe_address. Empty: no top-ups, keys are funded by hand.
PAY_TREASURY_SAFE_ADDRESS_POLYGON=
# The same four for Arbitrum One (PLAN.md section 15; `arbitrum` in PAY_ENABLED_CHAINS). Its factory is in chains.toml.
PAY_RPC_URLS_ARBITRUM=
PAY_FACTORY_ADDRESS_ARBITRUM=
PAY_OPERATOR_PRIVATE_KEY_ARBITRUM=
PAY_SWEEPER_PRIVATE_KEYS_ARBITRUM=
PAY_TREASURY_SAFE_ADDRESS_ARBITRUM=
# Per Monero chain (PLAN.md section 14): comma-separated `url=operator` pairs replacing chains.toml's nodes, e.g.
# `https://node.example.org:18089=example.org,https://xmr.example.net=example.net`. The operator is named, never
# inferred: two hosts of one operator count once, and at least 2 operators are required. Mainnet takes https only,
# stagenet http too. Empty: chains.toml's list.
PAY_MONERO_NODES_MONERO=
# The xmr-scanner sidecar's base URL (http://xmr-scanner:8750 under the compose `monero` profile): it checks a Monero
# wallet before it is saved, derives XMR invoices' subaddresses, reports the tip and checks a pasted txid. Empty:
# setting a Monero wallet and making an XMR invoice answer 503 monero_sidecar_unavailable.
PAY_MONERO_SIDECAR_URL=

# --- Invoices -------------------------------------------------------------------------------------------------------
# The operator's own payout address: the only destination whose invoices get refunds from the operator float.
PAY_DEFAULT_DESTINATION_ADDRESS=
# The operator's own account ids (accounts.id, comma-separated; sign up first, then look them up). Order matters:
# operator alerts go to the first. Only these accounts' own invoices paying PAY_DEFAULT_DESTINATION_ADDRESS get float
# refunds: payout addresses are not verified, so matching on the address alone would let anyone claim them. Empty: no
# operator alerts on any account, no float refunds. The watcher logs a warning at start for an id no account has.
PAY_OPERATOR_ACCOUNT_IDS=
# Smallest refund offered to a payer, in USD (below it the excess stays with the receiver).
PAY_MINIMUM_REFUND_USD=1.00
# Open (unclosed) invoices one client network may have at once; creation past it answers 429.
PAY_MAXIMUM_OPEN_INVOICES_PER_IP=5
# The same over a whole IPv6 /48, on top of each /64's cap (one holder of a /48 has 65,536 /64s).
PAY_MAXIMUM_OPEN_INVOICES_PER_IPV6_48=50
# Open public invoices (signed out, or a quantity link's payer) one chain may have at once; creation past it answers
# 429 public_invoice_capacity_reached. Every open invoice is read on every watcher tick.
PAY_MAXIMUM_OPEN_PUBLIC_INVOICES_PER_CHAIN=2000
# Public writes per minute from one IPv6 /48 together, on top of each /64's 10 (429 rate_limited past it).
PAY_PUBLIC_WRITES_PER_MINUTE_PER_IPV6_48=60
# Invoices made with an account's API token skip the per-IP cap; instead an account may have this many
# open invoices when its server makes another (429 too_many_open_invoices past it).
PAY_MAXIMUM_OPEN_INVOICES_PER_ACCOUNT=500
# Creations with an API token (invoices, payment links, static deposit addresses), per account per minute (429
# rate_limited past it).
PAY_API_TOKEN_INVOICE_CREATES_PER_MINUTE=60
# Static deposit addresses one account may have (409 past it; PLAN.md section 17). Each is
# scanned for good, so this bounds what one account adds to the watcher's reads.
PAY_MAXIMUM_STATIC_DEPOSIT_ADDRESSES_PER_ACCOUNT=1000
# Invoice schedules one account may have that have not ended (active or paused); 409 too_many_invoice_schedules past it.
PAY_MAXIMUM_INVOICE_SCHEDULES_PER_ACCOUNT=100
# Required, 64 hex digits from `openssl rand -hex 32`, written into .env without echoing it. Each new
# invoice's deposit salt is HMAC-SHA256 of its id under it, so `python -m app.cli recover-deposit` can find and sweep
# a deposit if Postgres is lost. Do not rotate it: older invoices recover only with the seed they were made under.
# Secret; keep a copy off this machine with the backup key.
PAY_INVOICE_SALT_SEED=

# --- Account webhooks -------------------------------------------------------------------------------------------------
# Keep false. true lets a webhook URL be plain http and point at loopback or private addresses (SSRF): only the e2e
# stack sets it, for its receiver container, and it is read only while fork chains alone are enabled. Webhook
# secrets are sealed under a key derived from PAY_INVOICE_SALT_SEED.
PAY_WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Leave empty. The fork e2e's stand-in for https://discord.com/api; read only while a fork chain (local_fork or local_arbitrum_fork) is enabled and no other chain is.
# Discord webhook tokens are sealed under another key derived from PAY_INVOICE_SALT_SEED.
PAY_E2E_DISCORD_API_BASE_URL=

# --- Sign-up screening ------------------------------------------------------------------------------------------------
# ip-api key; empty skips the lookup. Secret.
PAY_IP_API_KEY=
# Salt of the stored client IP hashes (rate limits, the open-invoice cap, the screening cache). Secret.
PAY_IP_HASH_SALT=
# Comma-separated peer IPs whose X-Real-IP is the client IP: the reverse proxy, at a fixed address on the shared proxy
# network (pick the top of the pool, so no container takes it first after a reboot).
# Empty: no peer is trusted, every client is its TCP address (local runs).
PAY_TRUSTED_PROXY_ADDRESSES=
# Screening of sign-up, the only screened step: invoices and payers are never screened.
PAY_SCREENING_BLOCK_PROXY=false
PAY_SCREENING_BLOCK_HOSTING=true
# Comma-separated ISO 3166-1 alpha-2 codes, e.g. KP,IR.
PAY_SCREENING_BLOCKED_COUNTRY_CODES=
# true refuses the sign-up when ip-api does not answer; false lets it through.
PAY_SCREENING_FAIL_CLOSED=false

# --- Local chain (compose profile `local-chain`) ---------------------------------------------------------------------
# The host's anvil binary, run inside the backend image. Empty: ${HOME}/.foundry/bin/anvil
PAY_ANVIL_BINARY=
# Host port of the anvil RPC (127.0.0.1 only).
PAY_ANVIL_PORT=18545
# Set to an RPC url to fork that chain; empty runs a plain anvil.
PAY_ANVIL_FORK_URL=
# Fork at this block; empty forks at the head (a load-balanced RPC may not serve the newest header yet).
PAY_ANVIL_FORK_BLOCK_NUMBER=
