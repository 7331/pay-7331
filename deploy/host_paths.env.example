# Where this host keeps the files the deploy, backup and e2e scripts read. Copy to deploy/host_paths.env (never in
# git, mode 600) and set every value; the scripts source it with bash and refuse to run while a variable they need is
# unset. Paths and names only: no secret goes in this file.

# Production settings, the Compose --env-file and the app containers' env_file (mode 600, from .env.example).
PAY_DEPLOY_ENVIRONMENT_FILE=/srv/pay-7331/production.env
# Testnet sandbox settings (mode 600, PAY_SANDBOX=true).
PAY_SANDBOX_ENVIRONMENT_FILE=/srv/pay-7331/sandbox.env
# The WAL-G settings deploy/write_postgres_wal_archive_settings.sh writes on every deploy; never edit it by hand.
PAY_WAL_ARCHIVE_SETTINGS_FILE=/srv/pay-7331/postgres-wal-archive.env
# The external Docker network the reverse proxy shares with the API containers.
PAY_REVERSE_PROXY_NETWORK=reverse_proxy
# The directory holding forge and anvil; empty means ${HOME}/.foundry/bin.
PAY_FOUNDRY_BIN_DIRECTORY=

# Backups, for runs by hand from this checkout. The systemd units read the same variables from their EnvironmentFile=.
# The backup encryption key (root, 0600), created by the first backup run. Copy it off the machine.
PAY_BACKUP_KEY_FILE=/srv/pay-7331/backup.key
# A Python with boto3.
PAY_BACKUP_PYTHON=/srv/pay-7331/backup-venv/bin/python
# A file with the BACKUP_STORAGE_ENDPOINT_URL, BACKUP_STORAGE_ACCESS_KEY, BACKUP_STORAGE_SECRET_KEY and
# BACKUP_STORAGE_BUCKET lines of the S3-compatible bucket; only those four lines are read.
PAY_BACKUP_STORAGE_CREDENTIALS_FILE=/srv/pay-7331/backup-storage.env
# Local copies of the sealed dumps.
PAY_BACKUP_DIRECTORY=/srv/pay-7331/backups/postgres
