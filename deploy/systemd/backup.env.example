# The backup units' EnvironmentFile=, installed as /etc/pay-7331/backup.env (root, 0600). Paths only, no secret.
PAY_BACKUP_KEY_FILE=/srv/pay-7331/backup.key
PAY_BACKUP_PYTHON=/srv/pay-7331/backup-venv/bin/python
PAY_BACKUP_STORAGE_CREDENTIALS_FILE=/srv/pay-7331/backup-storage.env
PAY_BACKUP_DIRECTORY=/srv/pay-7331/backups/postgres
PAY_WAL_ARCHIVE_SETTINGS_FILE=/srv/pay-7331/postgres-wal-archive.env
